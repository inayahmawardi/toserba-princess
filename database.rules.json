{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (newData.hasChildren(['role']) && ((data.exists() && newData.child('role').val() === data.child('role').val()) || (!data.exists() && newData.child('role').val() === 'customer'))))"
      }
    },
    "carts": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && auth.token.email_verified === true && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "orders": {
      "$uid": {
        ".read": "auth != null && auth.token.email_verified === true && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && auth.token.email_verified === true && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    }
  }
}
